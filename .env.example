# Variáveis opcionais do docker-compose.yml (copie para .env apenas se quiser mudar).
# Valores de desenvolvimento local; nunca reutilize em produção.
BIGDEVZ_DB_PASSWORD=troque-por-uma-senha-local
BIGDEVZ_DB_PORT=5440
BIGDEVZ_API_PORT=8000
# 127.0.0.1 restringe a API ao Mac. Use 0.0.0.0 só para testar em aparelho físico na mesma rede.
BIGDEVZ_API_BIND=127.0.0.1
BIGDEVZ_SUBNET=10.88.231.0/24
