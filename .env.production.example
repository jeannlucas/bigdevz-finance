# ==============================================================================
# BigDev.Z Finance — Configurações de Produção (Alinhadas à VPS srv1884441)
# NUNCA versione o arquivo .env.production com credenciais ou segredos reais.
# No servidor, estas variáveis residem em /srv/finance/production.conf ou .env.production.
# ==============================================================================

# Identificação da Aplicação
APP_NAME="BigDev.Z Finance"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://finance.bigdevz.com

# Chave criptográfica da aplicação (obrigatória em produção)
# Gerar com: php artisan key:generate --show
APP_KEY=base64:DEFINA_AQUI_A_CHAVE_BASE64_GERADA_PELO_ARTISAN

# Banco de Dados PostgreSQL 17 Alpine (Topologia existente)
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=bigdevz_finance
DB_USERNAME=bigdevz
DB_PASSWORD=DEFINA_UMA_SENHA_FORTE_EXCLUSIVA_DO_BANCO_DE_PRODUCAO

# Concorrência e Workers do PHP CLI Server
PHP_CLI_SERVER_WORKERS=4

# Portas e Bind no Host da VPS (Caddy no host faz o proxy reverso TLS)
BIGDEVZ_API_BIND=127.0.0.1
BIGDEVZ_API_PORT=8510

# CORS e Domínios Confiáveis
CORS_ALLOWED_ORIGINS=https://finance.bigdevz.com
SANCTUM_STATEFUL_DOMAINS=finance.bigdevz.com

# Sessão, Cache e Filas (Alinhado com a VPS)
SESSION_DRIVER=cookie
CACHE_STORE=database
QUEUE_CONNECTION=database

# Logs e Auditoria
LOG_CHANNEL=stack
LOG_LEVEL=error

# Fuso Horário Canônico Financeiro
FINANCE_TIMEZONE=America/Sao_Paulo
